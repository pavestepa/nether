type Pet {
    name: String,
    age: i32,
}

impl Pet {
    new(name: String, age: i32): Pet {
        Pet { name, age }
    }

    birthday(mut self) {
        self.age = self.age + 1;
    }
}

impl Pet: Into<String> {
    into_string(self): String {
        `${self.name} (${self.age})`
    }
}

type Shelter {
    title: String,
    featured: weak Pet,
}

enum Adoption {
    Available,
    Reserved(String),
    Adopted(String),
}
