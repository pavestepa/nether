mod model;
mod reports;

use self.model.Adoption;
use self.model.Pet;
use self.model.Shelter;
use self.reports.adoption_text;
use self.reports.featured_name;
use self.reports.option_pet_name;
use self.reports.print_roster;

fn main() {
    let luna = Pet.new("Luna", 2);
    let milo = Pet.new("Milo", 4);
    let shelter = Shelter { title: "North Star", featured: luna };

    let mut pets = [luna];
    pets.push(milo);
    pets.push(Pet.new("Nova", 1));

    println(`shelter=${shelter.title}`);
    println(`featured=${featured_name(shelter)}`);
    print_roster(pets);

    let state = Adoption.Reserved("Saturday");
    println(adoption_text(state));

    let prefix = "card";
    let card = (pet: Pet) => {
        `${prefix}: ${pet.name}, age ${pet.age}`
    };
    println(card(Pet.new("Echo", 3)));

    let missing: Option<Pet> = Option.None;
    println(option_pet_name(missing));
}
