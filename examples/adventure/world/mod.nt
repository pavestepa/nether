mod events;

use self.events.Event;

type Hero {
    name: String,
    hp: i32,
    score: i32,
}

impl Hero {
    new(name: String, hp: i32): Hero {
        Hero { name, hp, score: 0 }
    }

    damage(mut self, amount: i32) {
        self.hp = self.hp - amount;
    }

    heal(mut self, amount: i32) {
        self.hp = self.hp + amount;
    }

    add_score(mut self, amount: i32) {
        self.score = self.score + amount;
    }
}

impl Hero: Into<String> {
    into_string(self): String {
        `${self.name}: hp=${self.hp}, score=${self.score}`
    }
}

enum QuestState {
    NotStarted,
    Active(String),
    Completed(i32),
}

fn quest_text(state: QuestState): String {
    match state {
        QuestState.NotStarted => "quest not started",
        QuestState.Active(name) => `active quest: ${name}`,
        QuestState.Completed(reward) => `quest complete, reward=${reward}`,
    }
}

fn apply_event(mut hero: Hero, event: Event): String {
    match event {
        Event.Found(points) => {
            hero.add_score(points);
            `found treasure worth ${points}`
        },
        Event.Damage(amount) => {
            hero.damage(amount);
            `received ${amount} damage`
        },
        Event.Rest(amount) => {
            hero.heal(amount);
            `restored ${amount} hp`
        },
        Event.Message(text) => text,
    }
}

fn announce<T: Into<String>>(value: T): String {
    `hero ${value}`
}
