use super.world.Hero;
use super.world.events.Event;

fn encounter(hero: Hero): [Event] {
    let mut events: [Event] = [];
    events.push(Event.Message(`A wild shadow approaches ${hero.name}`));
    events.push(Event.Damage(6));
    if hero.hp > 10 {
        events.push(Event.Found(12));
    } else {
        events.push(Event.Rest(4));
    }
    events
}
